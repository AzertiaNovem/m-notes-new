[Unit]
Description=Mistakebook Alpha C++ API
After=network.target

[Service]
Type=simple
User=mistakebook-alpha
Group=mistakebook-alpha
WorkingDirectory=/opt/mistakebook-alpha/current
EnvironmentFile=/etc/mistakebook-alpha/environment
ExecStart=/opt/mistakebook-alpha/current/bin/mistakebook
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
StateDirectory=mistakebook-alpha
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mistakebook-alpha
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
