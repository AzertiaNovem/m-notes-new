# Run from the project root. SQLite is embedded; no database server is needed.
DATABASE_PATH=data/mistakebook.db
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:8080
WEB_ROOT=packages/web/dist
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174
# Empty by default. Set only when a reverse proxy overwrites X-Real-IP.
TRUSTED_PROXY_IPS=
TAG_MERGE_THRESHOLD=0.92
NOTE_LINK_THRESHOLD=0.80
